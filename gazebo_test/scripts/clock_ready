#!/usr/bin/env python3
"""Exit 0 once the simulation clock advances, 1 if it does not within --timeout.

The start gate of a lane: a compose ``sim`` service uses it as its healthcheck,
so Nav2 and the experiment manager start only when gzserver is up and
publishing /clock. Run it in the lane's environment (ROS_DOMAIN_ID, RMW):

    ros2 run gazebo_test clock_ready --timeout 10

The experiment manager pauses Gazebo between episodes, and a paused world
publishes no /clock: the check then reports "not ready". Use it to gate the
start of a lane, not to watch a running one.
"""

import argparse
import sys
import time

import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy
from rosgraph_msgs.msg import Clock


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--timeout", type=float, default=10.0, help="wall seconds (default 10)")
    parser.add_argument("--topic", default="/clock")
    args, _ = parser.parse_known_args()

    rclpy.init()
    node = Node("clock_ready")
    stamps = []
    # Best effort matches both reliable and best-effort /clock publishers.
    qos = QoSProfile(depth=10, reliability=ReliabilityPolicy.BEST_EFFORT)
    node.create_subscription(
        Clock, args.topic,
        lambda msg: stamps.append(msg.clock.sec + msg.clock.nanosec * 1e-9), qos)
    deadline = time.monotonic() + args.timeout
    ready = False
    try:
        while time.monotonic() < deadline:
            rclpy.spin_once(node, timeout_sec=0.2)
            if len(stamps) >= 2 and stamps[-1] > stamps[0]:
                ready = True
                break
    finally:
        node.destroy_node()
        rclpy.try_shutdown()
    if ready:
        print(f"{args.topic} advancing: sim time {stamps[-1]:.2f} s")
        return 0
    print(f"{args.topic} not advancing within {args.timeout:g} s ({len(stamps)} message(s))")
    return 1


if __name__ == "__main__":
    sys.exit(main())
