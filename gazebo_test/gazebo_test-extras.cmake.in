# copied from gazebo_test/gazebo_test-extras.cmake

# register ament_package() hook for node plugins once.
macro(_experiment_register_package_hook)
  if(NOT DEFINED _EXPERIMENT_PACKAGE_HOOK_REGISTERED)
    set(_EXPERIMENT_PACKAGE_HOOK_REGISTERED TRUE)

    find_package(ament_cmake_core QUIET REQUIRED)
    ament_register_extension("ament_package" "gazebo_test"
      "experiment_register_package_hook.cmake")
  endif()
endmacro()

get_filename_component(@PROJECT_NAME@_SHARE_DIR "${@PROJECT_NAME@_DIR}" DIRECTORY)

include("${gazebo_test_DIR}/experiment_register.cmake")