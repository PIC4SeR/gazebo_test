<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gazebo_test_cli</name>
  <version>0.0.0</version>
  <description>Command-line front-end for gazebo_test: the full_experiment orchestrator, installed as a console_scripts entry point (on PATH) so shell tab-completion works, and as a native `ros2 gazeboexp` command.</description>
  <maintainer email="andrea.ostuni@polito.it">Andrea Ostuni</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>gazebo_test</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-argcomplete</exec_depend>
  <exec_depend>ros2cli</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
